# Lokale Secrets -- diese Datei zu .env kopieren und mit echten Werten
# füllen. .env selbst ist in .gitignore und wird NIE committed.
#
#   cp .env.example .env
#
# core/billing.py / config/settings.py lesen diese Werte per os.environ
# (via python-dotenv, siehe config/settings.py).

# README Block 6 "Abrechnung": Stripe-Keys aus dem Stripe-Dashboard
# (Developers -> API keys). Test-Mode-Keys (sk_test_.../pk_test_...) reichen
# zum Entwickeln, funktionieren unverändert mit Live-Keys beim
# Produktivumstieg -- einfach hier ersetzen.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing-Secret des Stripe-Webhook-Endpoints (whsec_...). Erst vorhanden,
# nachdem der Endpoint https://<eure-domain>/api/billing/webhook/ im Stripe
# Dashboard -> Developers -> Webhooks -> "Add endpoint" registriert wurde
# (Events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed).
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe-Price-ID für "pro aktivem Mitarbeitenden/Monat" -- einmalig per
# `python manage.py setup_stripe_billing` angelegt (siehe
# core/management/commands/setup_stripe_billing.py), die ausgegebene
# Price-ID hier eintragen.
STRIPE_PRICE_ID=
